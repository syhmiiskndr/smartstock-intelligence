# Copy this file to .env and fill in your own values. Never commit .env.
# Only the project URL and the anon (public) key belong in the web app.
# The service_role key must never be put in this project.
VITE_SUPABASE_URL=
# Paste the Publishable key (sb_publishable_...) from Supabase -> Settings -> API Keys
VITE_SUPABASE_ANON_KEY=
# AI freshness service (ai/service). Leave empty to keep the Fresh page on 'coming soon'.
# Local test: http://localhost:8000 (start the service with ALLOWED_ORIGINS=http://localhost:5173).
# Never put the service's AI_SERVICE_KEY here, anything in the web app is public.
VITE_AI_SERVICE_URL=
